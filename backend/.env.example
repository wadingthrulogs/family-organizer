# backend/.env — used by `npm run dev` / `npm test`, and loaded into the Docker
# backend container via docker-compose `env_file`. In Docker, NODE_ENV,
# DATABASE_URL, SQLITE_PATH, APP_BASE_URL, TZ, SESSION_SECURE, SESSION_SECRET,
# ENCRYPTION_KEY and RECIPE_EXTRACT_* are set by docker-compose.yml (from the
# root .env) and override anything here. Most optional keys below can instead
# be set in the UI: Settings → Server Configuration (admin).

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Public-facing URL (used for OAuth callbacks and session cookies).
# Set to the IP/hostname family members use to reach the app.
# Examples:
#   http://localhost                                ← default (Docker, plain HTTP)
#   http://192.168.1.50                             ← LAN IP
#   https://familyorganizer.<tailnet>.ts.net        ← Tailscale HTTPS (recommended)
#   https://family.example.com                      ← public domain
APP_BASE_URL=http://localhost

# Set to true when the app is served over HTTPS (required for secure session cookies
# and browser push notifications). Must be false on plain HTTP or login won't stick.
SESSION_SECURE=false

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Must decode to exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Timezone for the server (e.g. America/Los_Angeles, America/New_York, UTC)
TZ=UTC

# ── Optional: Google Calendar ─────────────────────────────────────────────────
# Create a Google Cloud project and OAuth 2.0 credentials.
# See README.md → "Google Calendar Integration" for a step-by-step guide.
# GOOGLE_REDIRECT_URL defaults to ${APP_BASE_URL}/api/v1/integrations/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=http://localhost/api/v1/integrations/google/callback

# ── Optional: Email notifications (SMTP) ─────────────────────────────────────
# For Gmail use an App Password (requires 2FA): myaccount.google.com → Security → App passwords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Family Organizer <you@gmail.com>

# ── Optional: Browser push notifications (VAPID) ─────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=

# ── Optional: Weather widget ──────────────────────────────────────────────────
# Get a free API key at https://openweathermap.org/api
# Also set weatherLocation in Settings → Household (city name or "lat,lon")
# OPENWEATHER_API_KEY=

# ── Optional: Webhook notifications ──────────────────────────────────────────
# Reminders with the webhook channel POST JSON here. Env-only (not in the UI).
# WEBHOOK_URL=https://example.com/hooks/family-organizer

# ── Optional: Recipe-photo extraction (local dev only) ───────────────────────
# In Docker these are set by docker-compose.yml. For `npm run dev`, point them
# at the dirs tools/recipe-image-watcher watches.
# RECIPE_EXTRACT_UPLOAD_DIR=/home/you/uploads
# RECIPE_EXTRACT_OUTPUT_DIR=/home/you/recipe-output
# RECIPE_EXTRACT_TIMEOUT_MS=75000

# Mapbox (commute ETAs) and the home address are configured in the Settings UI.
