{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Organizer",
  "mainBinaryName": "family-organizer-desktop",
  "version": "0.1.0",
  "identifier": "family.organizer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Family Organizer",
        "url": "index.html",
        "fullscreen": true,
        "decorations": false,
        "resizable": true,
        "focus": true,
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Family Organizer desktop shell",
    "longDescription": "Native desktop shell for the self-hosted Family Organizer. Waits for the server to come up, then displays the app fullscreen with no browser chrome.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
