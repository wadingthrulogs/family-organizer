# Supply-chain hardening for this workspace.
#
# Not copied into the Docker images — backend/Dockerfile and frontend/Dockerfile
# copy only package.json and package-lock.json, so container builds are
# unaffected by anything set here.

# Refuse any version published in the last 7 days. Compromised releases are
# typically caught and yanked within hours to days, so this window means we are
# never among the first to install one. Requires npm >= 11.10 (unit: days).
#
# When this blocks a fix that `npm audit fix` wants to install, npm keeps the
# vulnerable version, warns, and exits non-zero. Override deliberately with
# `min-release-age-exclude=<pkg>` rather than by lowering this globally.
min-release-age=7

# Do not run install lifecycle scripts (preinstall/postinstall). This is the
# vector the March 2026 axios compromise used to drop its payload, and it is
# effective independently of the cooldown above.
ignore-scripts=true

# NOTE: @playwright/test downloads browsers from a lifecycle script.
# Run `npx playwright install` after any install here.
