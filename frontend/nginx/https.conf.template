# HTTPS mode. Rendered by 40-select-tls.sh when a cert for ${TLS_HOSTNAME}
# is mounted at /etc/ssl/tailscale (see tailscale-setup.sh).
server {
    listen 80;
    server_name _;

    # Health checks stay reachable over plain HTTP; everything else upgrades.
    location = /healthz {
        proxy_pass http://backend:3000/healthz;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/ssl/tailscale/${TLS_HOSTNAME}.crt;
    ssl_certificate_key /etc/ssl/tailscale/${TLS_HOSTNAME}.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include /etc/nginx/snippets/app-locations.conf;
}
